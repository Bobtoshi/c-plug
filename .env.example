# Copy this file to .env. The .env file stays local and never reaches the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
KSTACK_PORT=4317
KSTACK_HOST=127.0.0.1
KSTACK_CODEX_PLANNER=0
KSTACK_CODEX_MODEL=gpt-5.6-luna
KSTACK_IMESSAGE_ENABLED=0
# Optional official WhatsApp Cloud API channel. All six values are required.
KSTACK_WHATSAPP_ENABLED=0
KSTACK_WHATSAPP_VERIFY_TOKEN=
KSTACK_WHATSAPP_APP_SECRET=
KSTACK_WHATSAPP_ACCESS_TOKEN=
KSTACK_WHATSAPP_PHONE_NUMBER_ID=
KSTACK_WHATSAPP_OWNER_NUMBER=
# Set this to a currently supported Meta Graph API version, for example vXX.X.
KSTACK_WHATSAPP_API_VERSION=
# One explicit master switch for Calendar, Mail, Shortcuts, and SSH adapters.
KSTACK_LIVE_CONNECTORS=0
# Local task/action history is pruned on startup. Set 0 to retain indefinitely.
KSTACK_RETENTION_DAYS=30
# Comma-separated exact Apple Shortcut names. Nothing else can be run.
KSTACK_SHORTCUTS=

# Optional community metrics. An HTTPS endpoint only makes the consent toggle
# available; collection remains off until the local user explicitly enables it.
KSTACK_TELEMETRY_ENDPOINT=
