# Run `npm run setup` to create an owner-only .env from this template.
# Universal AI provider. Leave CPLUG_AI_PROVIDER blank to use the deterministic
# fallback, or enable the already-authenticated Codex CLI below.
# Supported values: openai-responses, openai-compatible, anthropic, gemini
CPLUG_AI_PROVIDER=
CPLUG_AI_MODEL=
# Easiest setup: paste any supported provider key here.
CPLUG_AI_API_KEY=
# Name of the environment variable that contains the key. The key itself stays
# server-side and may use any provider-specific variable name. This advanced
# option is ignored when CPLUG_AI_API_KEY is set.
CPLUG_AI_API_KEY_ENV=
# Optional exact endpoint. HTTPS is required except for loopback local models.
CPLUG_AI_BASE_URL=

# Examples of key variables. Populate only the one selected above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CPLUG_PORT=4317
CPLUG_HOST=127.0.0.1
CPLUG_CODEX_PLANNER=0
CPLUG_CODEX_MODEL=gpt-5.6-luna
CPLUG_IMESSAGE_ENABLED=0
# Optional official WhatsApp Cloud API channel. All six values are required.
CPLUG_WHATSAPP_ENABLED=0
CPLUG_WHATSAPP_VERIFY_TOKEN=
CPLUG_WHATSAPP_APP_SECRET=
CPLUG_WHATSAPP_ACCESS_TOKEN=
CPLUG_WHATSAPP_PHONE_NUMBER_ID=
CPLUG_WHATSAPP_OWNER_NUMBER=
# Set this to a currently supported Meta Graph API version, for example vXX.X.
CPLUG_WHATSAPP_API_VERSION=
# One explicit master switch for Calendar, Mail, Shortcuts, and SSH adapters.
CPLUG_LIVE_CONNECTORS=0
# Local task/action history is pruned on startup. Set 0 to retain indefinitely.
CPLUG_RETENTION_DAYS=30
# Comma-separated exact Apple Shortcut names. Nothing else can be run.
CPLUG_SHORTCUTS=

# Optional community metrics. An HTTPS endpoint only makes the consent toggle
# available; collection remains off until the local user explicitly enables it.
CPLUG_TELEMETRY_ENDPOINT=
